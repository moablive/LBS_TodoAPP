# =============================================================================
# TodoAPP — .env ESPECÍFICO. Infra comum em ../shared.env.
# DATABASE_URL é montado pelo docker-compose como ${DB_DSN}/${DB_NAME}.
# Subir:  docker compose --env-file ../shared.env --env-file .env up -d --build
# =============================================================================

# Sobrescreve o padrão do shared (production) — comportamento atual preservado.
NODE_ENV=development

CORS_ORIGIN='https://todo.astralwavelabel.com,http://localhost:5173,http://localhost'

# Nome do banco no server_db_postgres (compose monta DATABASE_URL com o DB_DSN).
DB_NAME='todoapp'

# ── LoginHub ─────────────────────────────────────────────────────────────────
LOGINHUB_APP_ID=4
VITE_LOGINHUB_APP_ID=4
# Backend e bot são server-side: falam com o LoginHub pelo DNS interno do
# Docker, sem sair para o Cloudflare. A URL pública equivalente é a
# VITE_LOGINHUB_API_URL abaixo, que existe só para o browser.
LOGINHUB_API_URL='http://server_loginhub_backend:3000/api'

# ── Frontend (Vite — BUILD TIME) ────────────────────────────────────────────
VITE_MONEYAPP_API_URL='https://money.astralwavelabel.com/api'
VITE_LOGINHUB_API_URL='https://loginhub.astralwavelabel.com/api'

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── IA (Ollama) ───────────────────────────────────────────────────────────
# OLLAMA_URL e OLLAMA_TEXT_MODEL vêm do ../shared.env (llama3.1:latest, o mesmo
# de todos os apps). Descomente só para divergir do padrão do ecossistema:
# OLLAMA_TEXT_MODEL='qwen2.5:7b'

# ── Telegram ──────────────────────────────────────────────────────────────
# Só o token — não existe chat_id fixo. O bot exige login via LoginHub e guarda
# o telegram_id de cada usuário no banco; é dali que sai o destino das mensagens.
TELEGRAM_BOT_TOKEN=

# Username do bot (sem @) — usado no deep link do vinculo hibrido do Telegram.
TELEGRAM_BOT_USERNAME=awlsrv_todo_bot

# Fase 3 — fecha o ramo cego (x-user-id), que aqui nunca foi usado.
ALLOW_LEGACY_BOT_DELEGATION=false

# ==========================================
# VERSÃO DO BUILD (gerado por scripts/bump-version.mjs — não editar à mão)
# ==========================================
APP_VERSION=0.0.0
APP_BUILD_DATE=
